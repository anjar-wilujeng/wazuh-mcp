# ── Wazuh MCP Server — Environment Variables ────────────────────────────────
# Copy file ini: cp .env.example .env
# Lalu sesuaikan nilai-nilainya.

# ── Wazuh Indexer (OpenSearch, port 9200) ─────────────────────────────────────
WAZUH_INDEXER_URL=https://wazuh-indexer:9200

# ── Wazuh Manager (REST API, port 55000) ──────────────────────────────────────
WAZUH_MANAGER_URL=https://wazuh-manager:55000

# ── Auth Indexer (WAJIB) ──────────────────────────────────────────────────────
WAZUH_USERNAME=admin
WAZUH_PASSWORD=GANTI_PASSWORD_INDEXER

# ── Auth Manager API — jika berbeda dari Indexer (opsional) ───────────────────
# Kosongkan jika pakai credential yang sama dengan Indexer
WAZUH_MANAGER_USERNAME=wazuh-wui
WAZUH_MANAGER_PASSWORD=GANTI_PASSWORD_MANAGER

# ── SSL ───────────────────────────────────────────────────────────────────────
# Set false hanya untuk development dengan self-signed cert
WAZUH_VERIFY_SSL=true
# Path ke CA cert (opsional, jika verify SSL aktif)
# WAZUH_CA_CERT_PATH=/certs/root-ca.pem

# ── Cluster ───────────────────────────────────────────────────────────────────
WAZUH_CLUSTER_NAME=wazuh-cluster
WAZUH_MASTER_NODE=wazuh-master
WAZUH_WORKER_NODE=wazuh-worker

# ── Daemon HTTP (opsional — untuk pemakaian persisten tanpa cold-start) ───────
# Dipakai oleh wazuh-mcp-http / run-mcp-http.sh. Default 127.0.0.1:8765.
WAZUH_MCP_HTTP_HOST=127.0.0.1
WAZUH_MCP_HTTP_PORT=8765

# ── Audit Log ─────────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=/var/log/wazuh-mcp/audit.log

# ── Server ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MAX_ALERTS_PER_QUERY=100

# ── Docker Network ────────────────────────────────────────────────────────────
# Nama network Docker Wazuh yang sudah ada (cek: docker network ls | grep wazuh)
WAZUH_DOCKER_NETWORK=wazuh_default
